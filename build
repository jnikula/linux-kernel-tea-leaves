set -eu

TAG=$(python3 src/tealeaves/fetch.py tag)
DATE=$(python3 src/tealeaves/fetch.py --tag="${TAG}" date)

echo $TAG
echo $DATE

python3 src/tealeaves/predict.py --tag="${TAG}" --date="${DATE}" > index.rst
rst2html --strict --no-raw index.rst > index.html
